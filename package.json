{
  "name": "virtual-buoys",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "simulate:30d": "node scripts/simulate-30-days.mjs",
    "backfill:initial": "node scripts/backfill-initial-stream.mjs",
    "check:public-access": "node scripts/check-supabase-public-access.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check:backend": "node scripts/check-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "maplibre-gl": "6.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jsdom": "26.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
